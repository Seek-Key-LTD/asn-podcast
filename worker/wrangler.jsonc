{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "asn-podcast-backend",
  "account_id": "e167cb36a5b95cb3cc8daf77a3f7d0b3",
  "main": "./index.ts",
  "minify": true,
  "upload_source_maps": true,
  "compatibility_date": "2025-11-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTORIZE_KUNPENGZHI",
      "index_name": "kunpengzhi-books"
    }
  ],
  "assets": {
    "directory": "./static"
  },
  "observability": {
    "traces": {
      "enabled": true
    },
    "logs": {
      "enabled": true
    }
  },
  "triggers": {
    "crons": [
      "30 23 * * *"
    ]
  },
  "keep_vars": true,
  "vars": {
    "TTS_PROVIDER": "omni",
    "TTS_API_URL": "https://colab-locks-gradio.git4ta.fun",
    "MAN_VOICE_ID": "/content/drive/MyDrive/voice/OmniVoice/Design_Voice/design_male.mp3",
    "WOMAN_VOICE_ID": "/content/drive/MyDrive/voice/OmniVoice/Design_Voice/design_female.mp3",
    "OPENAI_BASE_URL": "https://freellmapi.git4ta.fun/v1",
    "OPENAI_API_KEY": "freellmapi-7304d343a34f8e4d2b7d4c7e33348fcc5ceca361f8cc422f",
    "OPENAI_MODEL": "auto",
    "SEARXNG_URL": "https://searx.seekkey.eu.org",
    "HACKER_PODCAST_WORKER_URL": "https://podcast.capitaltrain.cn/api/worker",
    "HACKER_PODCAST_R2_BUCKET_URL": "https://podcast.git4ta.fun",
    "NODE_ENV": "development",
    "QSTASH_URL": "https://qstash-us-east-1.upstash.io",
    "QSTASH_TOKEN": "eyJVc2VySUQiOiIzMTA5YTJmNy04NmRjLTRiOWYtOWM3ZS0xMzVhMGI4ODNiMmMiLCJQYXNzd29yZCI6IjM4ZGMyNDI1NTQ0MzQwNzliZTRiMmU3Mzk5NzUxYzI0In0=",
    "QSTASH_CURRENT_SIGNING_KEY": "sig_4ku8tCoMLBM2Qn1RFmBgEKLT9rom",
    "QSTASH_NEXT_SIGNING_KEY": "sig_87j6Ln2A4S6vmTcuPFm9D6RhCKaD"
  },
  "browser": {
    "binding": "BROWSER"
  },
  "workflows": [
    {
      "name": "asn-podcast-workflow",
      "binding": "HACKER_PODCAST_WORKFLOW",
      "class_name": "HackerNewsWorkflow"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "HACKER_PODCAST_KV",
      "id": "6a50d6f93dcc467a8552f889cd238da1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "HACKER_PODCAST_R2",
      "bucket_name": "hacker-podcast"
    }
  ]
}